rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Yönetici hesaplarının UID'leri: firebase-config.js içindeki "admins" listesiyle aynı tutun
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in ['VP4mUdPWc0R0wQEkPvRHTa3YDR42'];
    }
    function signedIn() { return request.auth != null; }
    function managerDoc() {
      return /databases/$(database)/documents/managers/$(request.auth.uid);
    }
    // Onaylanmış takım hesabı ve bu takımın sorumlusu mu?
    function isManagerOf(team) {
      return signedIn() && exists(managerDoc()) && get(managerDoc()).data.team == team;
    }
    function isDelete() { return request.resource == null; }
    function smallStr(v, n) { return v is string && v.size() <= n; }
    function jpeg(v, n) { return smallStr(v, n) && v.matches('data:image/jpeg;base64,.*'); }

    match /matches/{matchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Maç başlama saatleri: tahmin oyununda maç başladıktan sonra tahmin değiştirilemesin diye
    match /kickoffs/{matchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /players/{playerId} {
      allow read: if true;
      function validPlayer() {
        return smallStr(request.resource.data.name, 60)
          && request.resource.data.name.size() > 0
          && request.resource.data.team is string;
      }
      allow create: if validPlayer()
        && (isAdmin() || (isManagerOf(request.resource.data.team)
                          && request.resource.data.get('ban', '') == ''));
      allow update: if validPlayer()
        && (isAdmin() || (isManagerOf(resource.data.team)
                          && request.resource.data.team == resource.data.team
                          && request.resource.data.get('ban', '') == resource.data.get('ban', '')));
      allow delete: if isAdmin() || isManagerOf(resource.data.team);
    }

    match /photos/{playerId} {
      allow read: if true;
      allow create, update: if jpeg(request.resource.data.data, 150000)
        && (isAdmin() || (isManagerOf(request.resource.data.team)
                          && (resource == null || resource.data.team == request.resource.data.team)));
      allow delete: if isAdmin() || isManagerOf(resource.data.team);
    }

    match /logos/{teamId} {
      allow read: if true;
      allow create, update: if jpeg(request.resource.data.data, 150000)
        && (isAdmin() || isManagerOf(request.resource.data.team));
      allow delete: if isAdmin() || isManagerOf(resource.data.team);
    }

    match /teams/{teamId} {
      allow read: if true;
      allow write: if isAdmin()
        || (!isDelete() && isManagerOf(request.resource.data.team)
            && (resource == null || resource.data.team == request.resource.data.team));
    }

    // Maç kadroları: belge kimliği "<maçId>__<takım adı>"
    match /lineups/{lineupId} {
      allow read: if true;
      allow create, update: if (isAdmin() || isManagerOf(request.resource.data.team))
        && lineupId == request.resource.data.match + '__' + request.resource.data.team
        && request.resource.data.start is list && request.resource.data.start.size() <= 16
        && request.resource.data.subs is list && request.resource.data.subs.size() <= 20;
      allow delete: if isAdmin() || isManagerOf(resource.data.team);
    }

    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin()
        && (isDelete()
            || (smallStr(request.resource.data.title, 120)
                && smallStr(request.resource.data.body, 3000)));
    }

    match /weekly/{tur} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{key} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sponsors/{sid} {
      allow read: if true;
      allow write: if isAdmin()
        && (isDelete() || (smallStr(request.resource.data.name, 80)
            && (request.resource.data.get('logo', '') == '' || jpeg(request.resource.data.logo, 150000))));
    }

    // Galeri: küçük resim listesi ve tam boy görseller ayrı tutulur
    match /gallery/{gid} {
      allow read: if true;
      allow write: if isAdmin() && (isDelete() || jpeg(request.resource.data.thumb, 60000));
    }
    match /galleryFull/{gid} {
      allow read: if true;
      allow write: if isAdmin() && (isDelete() || jpeg(request.resource.data.data, 900000));
    }

    // Taraftar oylaması: belge kimliği "<maçId>__<uid>", sadece biten maçlar için
    match /mvpvotes/{vid} {
      allow read: if true;
      allow create, update: if signedIn()
        && vid == request.resource.data.match + '__' + request.auth.uid
        && request.resource.data.player is string
        && get(/databases/$(database)/documents/matches/$(request.resource.data.match)).data.get('status', '') == 'done';
      allow delete: if isAdmin();
    }

    // Tahmin oyunu: her taraftarın tek belgesi; her yazışta en fazla bir maçın tahmini değişebilir
    // ve o maç henüz başlamamış olmalı.
    match /fans/{uid} {
      allow read: if true;
      function validFan() {
        return smallStr(request.resource.data.nick, 24) && request.resource.data.nick.size() >= 2
          && request.resource.data.p is map && request.resource.data.p.size() <= 130;
      }
      function beforeKickoff(mid) {
        return request.time < get(/databases/$(database)/documents/kickoffs/$(mid)).data.at;
      }
      allow create: if signedIn() && request.auth.uid == uid && validFan()
        && (request.resource.data.p.size() == 0
            || (request.resource.data.p.size() == 1 && beforeKickoff(request.resource.data.p.keys()[0])));
      allow update: if signedIn() && request.auth.uid == uid && validFan()
        && (request.resource.data.p.diff(resource.data.p).affectedKeys().size() == 0
            || (request.resource.data.p.diff(resource.data.p).affectedKeys().size() == 1
                && beforeKickoff(request.resource.data.p.diff(resource.data.p).affectedKeys().toList()[0])));
      allow delete: if isAdmin();
    }

    match /managers/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    match /requests/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid
        && smallStr(request.resource.data.team, 40)
        && smallStr(request.resource.data.name, 60)
        && smallStr(request.resource.data.email, 120)
        && smallStr(request.resource.data.get('phone', ''), 20)
        && smallStr(request.resource.data.get('note', ''), 300);
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
