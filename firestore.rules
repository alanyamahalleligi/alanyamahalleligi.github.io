rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Yönetici hesaplarının UID'leri: public/firebase-config.js içindeki "admins" listesiyle aynı tutun
    // Ana yönetici: yönetici ekleyip çıkarabilen tek hesap (public/firebase-config.js "admins" ile aynı)
    function isOwner() {
      return request.auth != null
        && request.auth.uid in ['VP4mUdPWc0R0wQEkPvRHTa3YDR42'];
    }
    // Yönetici: ana yönetici ya da admins koleksiyonunda kaydı olan hesap
    function isAdmin() {
      return isOwner()
        || (request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    function signedIn() { return request.auth != null; }
    function managerDoc() {
      return /databases/$(database)/documents/managers/$(request.auth.uid);
    }
    function isManager() { return signedIn() && exists(managerDoc()); }
    function myTeam() { return get(managerDoc()).data.team; }
    function isManagerOf(team) { return isManager() && myTeam() == team; }
    function isDelete() { return request.resource == null; }
    function smallStr(v, n) { return v is string && v.size() <= n; }
    function jpeg(v, n) { return smallStr(v, n) && v.matches('data:image/jpeg;base64,.*'); }
    // Güncellemede yalnızca tek bir üst alan değişmiş mi?
    function onlyField(f) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([f]);
    }
    function started(matchId) {
      return request.time > get(/databases/$(database)/documents/kickoffs/$(matchId)).data.at;
    }

    // ---- Toplu belgeler: ziyaretçi başına okuma sayısını düşük tutmak için ----
    // agg/m-1..m-5, m-ko {m}, players {p}, teams {t}, logos {l}, news {n}, misc, board, nicks
    // Hepsini yalnızca yönetici yazar. Takım hesapları değişikliklerini "pending" koleksiyonuna
    // gönderir; yönetici onaylayınca buraya işlenir.
    match /agg/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Takım hesaplarının onay bekleyen değişiklikleri
    match /pending/{id} {
      allow read: if isAdmin() || (isManager() && resource.data.team == myTeam());
      allow create: if isManager()
        && request.resource.data.team == myTeam()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.type in ['player', 'playerDel', 'team']
        && smallStr(request.resource.data.key, 120)
        && request.resource.data.data is map;
      allow delete: if isAdmin() || (isManager() && resource.data.team == myTeam());
    }

    // Maç başlama saatleri (taraftar oylaması maç başlamadan açılmasın diye)
    match /kickoffs/{matchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Oyuncu fotoğrafları: yalnızca yönetici yazar (onay sonrası)
    match /tphotos/{team} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /photos/{playerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Maç kadroları onay beklemez: yönetici ya da o takımın hesabı yazar. Kimlik "<maçId>__<takım adı>"
    match /lineups/{lineupId} {
      allow read: if true;
      allow create, update: if (isAdmin() || isManagerOf(request.resource.data.team))
        && lineupId == request.resource.data.match + '__' + request.resource.data.team
        && request.resource.data.start is list && request.resource.data.start.size() <= 16
        && request.resource.data.subs is list && request.resource.data.subs.size() <= 20;
      allow delete: if isAdmin() || isManagerOf(resource.data.team);
    }

    match /sponsors/{sid} {
      allow read: if true;
      allow write: if isAdmin()
        && (isDelete() || (smallStr(request.resource.data.name, 80)
            && (request.resource.data.get('logo', '') == '' || jpeg(request.resource.data.logo, 150000))));
    }

    match /gallery/{gid} {
      allow read: if true;
      allow write: if isAdmin() && (isDelete() || jpeg(request.resource.data.thumb, 60000));
    }
    match /galleryFull/{gid} {
      allow read: if true;
      allow write: if isAdmin() && (isDelete() || jpeg(request.resource.data.data, 900000));
    }

    // Taraftar oylaması: maç başına tek belge {v: {uid: oyuncuId}}; herkes yalnızca kendi oyunu yazar
    match /mvpvotes/{matchId} {
      allow read: if true;
      allow create: if signedIn() && started(matchId)
        && request.resource.data.keys().hasOnly(['v'])
        && request.resource.data.v.keys().hasOnly([request.auth.uid])
        && smallStr(request.resource.data.v[request.auth.uid], 40);
      allow update: if signedIn() && started(matchId) && onlyField('v')
        && request.resource.data.v.diff(resource.data.v).affectedKeys().hasOnly([request.auth.uid])
        && smallStr(request.resource.data.v[request.auth.uid], 40);
      allow delete: if isAdmin();
    }

    // Ek yöneticiler: yalnızca ana yönetici ekler ve çıkarır
    match /admins/{uid} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == uid);
      allow write: if isOwner();
    }

    match /managers/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    match /requests/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid
        && smallStr(request.resource.data.team, 40)
        && smallStr(request.resource.data.name, 60)
        && smallStr(request.resource.data.email, 120)
        && smallStr(request.resource.data.get('phone', ''), 20)
        && smallStr(request.resource.data.get('note', ''), 300);
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
