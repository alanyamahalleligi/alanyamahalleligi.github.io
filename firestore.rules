rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Yönetici hesaplarının UID'leri: firebase-config.js içindeki "admins" listesiyle aynı tutun
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in ['VP4mUdPWc0R0wQEkPvRHTa3YDR42'];
    }
    function isDelete() {
      return request.resource == null;
    }

    match /matches/{matchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /players/{playerId} {
      allow read: if true;
      allow write: if isAdmin()
        && (isDelete()
            || (request.resource.data.name is string
                && request.resource.data.name.size() <= 60
                && request.resource.data.team is string));
    }

    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin()
        && (isDelete()
            || (request.resource.data.title is string
                && request.resource.data.title.size() <= 120
                && request.resource.data.body is string
                && request.resource.data.body.size() <= 3000));
    }

    match /teams/{teamId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
